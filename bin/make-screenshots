#!/bin/sh

set -eu

for tool in emacs import xvfb-run; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'The screenshots target requires %s.\n' "$tool" >&2
        exit 127
    fi
done

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

env GDK_BACKEND=x11 xvfb-run -a -s "-screen 0 1280x900x24 -dpi 96" \
    emacs -Q --load "$repo_root/bin/generate-screenshots.el"
printf 'Generated the README screenshots.\n'

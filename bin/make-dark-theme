#!/usr/bin/env sh

set -eu

command -v python3 >/dev/null || { printf 'Python 3 is required.\n' >&2; exit 127; }

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
output=$(mktemp "$repo_root/lisp/.leuven-dark-theme.XXXXXX")
trap 'rm -f -- "$output"' EXIT
trap 'exit 1' HUP INT TERM

cd "$repo_root/bin"
python3 negate.py "$repo_root/lisp/leuven-theme.el" > "$output"
sed -i \
    -e 's/leuven/leuven-dark/g' \
    -e 's/leuven-dark-dark/leuven-dark/g' \
    -e 's/for a white background/for a dark background/g' \
    -e 's/with a light background/with a dark background/g' \
    "$output"

cat "$output" > "$repo_root/lisp/leuven-dark-theme.el"
printf 'Regenerated lisp/leuven-dark-theme.el from the light theme.\n'
